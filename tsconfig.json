{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "typeRoots": ["../yusa/node_modules/@types"]
  },
  "include": ["src", "scripts/*.ts"]
}
